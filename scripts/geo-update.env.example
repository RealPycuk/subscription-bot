# Рабочая папка: лог, хэш установленных файлов, бинарник xray для проверки
WORK_DIR=/opt/geo-update
# .env бота: оттуда берутся BOT_TOKEN, ADMIN_ID, PANEL_API_TOKEN
BOT_ENV=/opt/subscription-bot/.env
PANEL_URL=https://panel.example.com:2053
# id нод в панели, которые нужно перезагрузить
NODE_IDS="1 2"
# контейнер ноды на этом сервере
LOCAL_NODE=sharx-node-local
# удалённая нода (оставьте REMOTE_EXEC пустым, если её нет)
REMOTE_EXEC="ssh -i /root/.ssh/node_key -o BatchMode=yes root@198.51.100.20"
REMOTE_NODE=sharx-node
# что проверить после перезагрузки: host:port через пробел
CHECK_TARGETS="203.0.113.10:449 198.51.100.20:449"
